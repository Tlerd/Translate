# Key chung cho hai provider; chi dien provider se su dung.
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Soniox streaming STT: server-only; enable temporary-key and realtime-STT permissions.
SONIOX_API_KEY=

# Nemotron STT: NeMo-Speech.cpp + authenticated WebSocket gateway.
# npm run speech:nemotron:setup writes local values to .env.local.
# Public deployments need an HTTPS backend / WSS gateway reachable by clients.
NEMOTRON_BASE_URL=
NEMOTRON_WEBSOCKET_URL=
NEMOTRON_GATEWAY_SECRET=
NEMOTRON_API_KEY=

# Tuy chon: key rieng cho tom tat/anh, cung provider voi model da chon.
SUMMARY_GOOGLE_API_KEY=
SUMMARY_OPENAI_API_KEY=
IMAGE_GOOGLE_API_KEY=
IMAGE_OPENAI_API_KEY=

AI_TRANSLATION_MODEL=google:gemini-3.5-flash-lite
AI_SUMMARY_MODEL=google:gemini-3.8-flash
AI_IMAGE_MODEL=google:gemini-3.1-flash-lite-image
AI_IMAGE_ENABLED=false
# Postgres chuan (driver pg): Neon, Cloud SQL, RDS, Supabase... deu dung duoc.
# Neon: dung connection string co "-pooler" va ?sslmode=require.
DATABASE_URL=
TRANSLATION_USAGE_STORE=on

# Kho audio chuan S3 (Cloudflare R2, AWS S3, Google Cloud Storage XML API, MinIO).
# Bucket phai PRIVATE; key chi o server, khong NEXT_PUBLIC_*.
# R2: S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com, S3_REGION=auto
# AWS S3: bo trong S3_ENDPOINT, S3_REGION=ap-southeast-1
# GCS: S3_ENDPOINT=https://storage.googleapis.com, S3_REGION=auto, key HMAC
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true cho MinIO/local; R2, S3, GCS de trong.
S3_FORCE_PATH_STYLE=

# Dang nhap mot chu ung dung va bo dem dung chung khi deploy.
AUTH_SECRET=
# Production: URL Cloud Run hoac ten mien rieng (khong them /app).
# Local: http://localhost:3000, hoac de trong de Auth.js suy ra origin.
AUTH_URL=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
OWNER_EMAIL=
# Redis chuan (giao thuc Redis, khong phai REST): Upstash, Memorystore, ElastiCache...
# Upstash: rediss://default:<password>@<host>.upstash.io:6379
REDIS_URL=
# Bo trong hoac production. Gia tri khac (vd. staging) chan nut don audio mo coi.
APP_ENV=
